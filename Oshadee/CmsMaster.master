<%@ Master Language="C#" AutoEventWireup="true" CodeFile="CmsMaster.master.cs" Inherits="CmsMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>CMS - <asp:ContentPlaceHolder ID="TitleContent" runat="server">Dashboard</asp:ContentPlaceHolder></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

    <style>
        :root {
           
            --black: #0B0D12;
            --black-dark: #000000;
            --orange: #E8622D;
            --orange-dark: #CC5222;
            --bg-light: #F4F4F5;
            --gray-text: #64748B;
            --border-color: #E2E8F0;
            --sidebar-width: 250px;

        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #F1F1F1;
            color: var(--black);
        }

        .cms-sidebar {
            position: fixed;
            top: 0; left: 0; bottom: 0;
            width: var(--sidebar-width);
            background: var(--black);
            overflow-y: auto;
            z-index: 100;
        }

        .cms-sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .cms-sidebar-logo .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #000000;
            border: 1px solid rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
        }
        .cms-sidebar-logo .icon-box svg { display: block; }

        .cms-sidebar-logo h1 {
            margin: 0;
            font-size: 19px;
            font-weight: 800;
            color: #fff;
        }

        .cms-sidebar-logo span {
            display: block;
            font-size: 10px;
            color: #9AA0AC;
            letter-spacing: 0.5px;
        }

        .cms-nav-section-title {
            padding: 18px 22px 8px 22px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #6C7280;
        }

        .cms-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 22px;
            color: #C9CDD6;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.15s ease, color 0.15s ease;
        }

        .cms-nav-link i { width: 18px; text-align: center; font-size: 14px; }

        .cms-nav-link:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
        }

        .cms-nav-link.active {
            background: var(--orange);
            color: #fff;
        }

        .cms-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .cms-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            padding: 16px 30px;
            border-bottom: 1px solid var(--border-color);
        }

        .cms-topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .cms-topbar-left h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: var(--black);
        }

        .cms-topbar-right {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .cms-date-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 13px;
            color: var(--gray-text);
        }

        .cms-bell {
            position: relative;
            color: var(--gray-text);
            font-size: 18px;
        }

        .cms-bell .badge {
            position: absolute;
            top: -6px; right: -8px;
            background: var(--orange-dark);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            border-radius: 50%;
            width: 16px; height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cms-user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cms-user-avatar {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: #FDEDE5;
            color: var(--orange-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .cms-user-name { font-size: 13px; font-weight: 700; color: var(--black); }
        .cms-user-role { font-size: 11px; color: var(--gray-text); }

        .cms-logout-link {
            color: var(--gray-text);
            font-size: 16px;
            text-decoration: none;
        }
        .cms-logout-link:hover { color: var(--orange-dark); }

        .cms-content {
            padding: 26px 30px;
            flex: 1;
        }

        .cms-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(20,23,31,0.06);
            padding: 20px 22px;
        }

        .cms-card h3 {
            margin: 0 0 16px 0;
            font-size: 15px;
            font-weight: 700;
            color: var(--black);
        }

        .cms-kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .cms-kpi-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(20,23,31,0.06);
            padding: 18px 20px;
        }

        .cms-kpi-icon {
            width: 42px; height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            margin-bottom: 12px;
            background: var(--orange);
        }

        .cms-kpi-value {
            font-size: 24px;
            font-weight: 800;
            color: var(--black);
            line-height: 1;
        }

        .cms-kpi-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--black);
            margin: 6px 0 2px 0;
        }

        .cms-kpi-sub {
            font-size: 12px;
            color: var(--gray-text);
        }

        .cms-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        .cms-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }

        .cms-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .cms-table th {
            text-align: left;
            color: var(--gray-text);
            font-weight: 700;
            padding: 10px 8px;
            border-bottom: 1px solid var(--border-color);
        }
        .cms-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #F1F5F9;
            color: var(--black);
        }

        .cms-status-pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }
        .cms-status-pending { background: #FEF3E2; color: #B7791F; }
        .cms-status-inprogress { background: #ECECEC; color: #1F2937; }
        .cms-status-completed { background: #E3F9E5; color: #1F9D55; }
        .cms-status-open { background: #FDECEC; color: #D64545; }

        .cms-btn-link {
            display: inline-block;
            background: linear-gradient(90deg, var(--orange) 0%, var(--orange-dark) 100%);
            color: #fff;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
        }

        @media (max-width: 1100px) {
            .cms-grid-4 { grid-template-columns: repeat(2, 1fr); }
            .cms-grid-2 { grid-template-columns: 1fr; }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="cmsForm" runat="server">
        <div class="cms-sidebar">
            <div class="cms-sidebar-logo">
                <div class="icon-box">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="2" x2="12" y2="13"></line>
                        <path d="M6 13 Q12 19 18 13"></path>
                        <line x1="7" y1="13" x2="6" y2="21"></line>
                        <line x1="9.5" y1="13.5" x2="9" y2="22"></line>
                        <line x1="12" y1="14" x2="12" y2="22"></line>
                        <line x1="14.5" y1="13.5" x2="15" y2="22"></line>
                        <line x1="17" y1="13" x2="18" y2="21"></line>
                    </svg>
                </div>
                <div>
                    <h1>CMS</h1>
                    <span>CLEANING MANAGEMENT SYSTEM</span>
                </div>
            </div>

            <a href="~/DashboardAdmin.aspx" runat="server" class="cms-nav-link active">
                <i class="fa-solid fa-gauge"></i> Dashboard
            </a>

            <!-- MASTERS - Admin only -->
            <asp:PlaceHolder ID="phMasters" runat="server">
                <div class="cms-nav-section-title">MASTERS</div>
                <a href="~/Masters/Location.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-location-dot"></i> Location</a>
                <a href="~/Masters/Section.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-border-all"></i> Section</a>
                <a href="~/Contractor.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-helmet-safety"></i> Contractors</a>
                <a href="~/Team.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-people-group"></i> Team</a>
                <a href="~/Staff.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-user"></i> Staff</a>
                <a href="~/Masters/Machines.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-gears"></i> Machines</a>
                <a href="~/UserAccount.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-users-gear"></i> User Accounts</a>
            
            </asp:PlaceHolder>

            <!-- APPLICATIONS - Admin & Supervisor -->
    
            <asp:PlaceHolder ID="phApplications" runat="server">
                <div class="cms-nav-section-title">APPLICATIONS</div>
                <a href="~/CleaningSchedule.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-calendar-days"></i> Cleaning Schedule</a>
                <a href="~/CleaningJobs.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-clipboard-list"></i> Cleaning Jobs</a>
                <a href="~/AdditionalWorkRequest.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-plus"></i> Additional Work</a>
                <a href="~/JobMaintenance.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-pen-to-square"></i> Job Maintenance</a>
                <a href="~/MachineMaintenance.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-screwdriver-wrench"></i> Machine Maintenance</a>   
                <a href="~/Feedback.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-comment-dots"></i> Feedback &amp; Complaints</a>
                <a href="~/Notification.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-bell"></i> Notifications</a>
            </asp:PlaceHolder>

            <!-- Staff-only simplified menu -->
            <asp:PlaceHolder ID="phStaffMenu" runat="server">
                <div class="cms-nav-section-title">MY WORK</div>
                <a href="~/Apps/MyJobs.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-list-check"></i> My Jobs Today</a>
                <a href="~/Apps/ReportBreakdown.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-triangle-exclamation"></i> Report Breakdown</a>
            </asp:PlaceHolder>

            <!-- Contractor-only simplified menu -->
            <asp:PlaceHolder ID="phContractorMenu" runat="server">
                <div class="cms-nav-section-title">MY WORK</div>
                <a href="~/Apps/MyMaintenance.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-screwdriver-wrench"></i> Maintenance Schedule</a>
                <a href="~/Apps/ReportBreakdown.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-triangle-exclamation"></i> Report Breakdown</a>
            </asp:PlaceHolder>

            <asp:PlaceHolder ID="phReports" runat="server">
                <div class="cms-nav-section-title">REPORTS</div>
                <a href="~/Reports/Reports.aspx" runat="server" class="cms-nav-link"><i class="fa-solid fa-chart-column"></i> Reports</a>
            </asp:PlaceHolder>
        </div>

        <div class="cms-main">
            <div class="cms-topbar">
                <div class="cms-topbar-left">
                    <h2><asp:ContentPlaceHolder ID="PageTitleContent" runat="server">Dashboard</asp:ContentPlaceHolder></h2>
                </div>
                <div class="cms-topbar-right">
                    <div class="cms-date-chip">
                        <i class="fa-regular fa-calendar"></i>
                        <asp:Literal ID="litToday" runat="server" />
                    </div>
                    <a href="~/Apps/Notifications.aspx" runat="server" class="cms-bell">
                        <i class="fa-regular fa-bell"></i>
                        <asp:Label ID="lblNotifCount" runat="server" CssClass="badge" Visible="false" />
                    </a>
                    <div class="cms-user-chip">
                        <div class="cms-user-avatar"><i class="fa-solid fa-user"></i></div>
                        <div>
                            <div class="cms-user-name"><asp:Literal ID="litUserName" runat="server" /></div>
                            <div class="cms-user-role"><asp:Literal ID="litUserRole" runat="server" /></div>
                        </div>
                    </div>
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="cms-logout-link"
                        OnClick="lnkLogout_Click" ToolTip="Log out">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </asp:LinkButton>
                </div>
            </div>

            <div class="cms-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>
</body>
</html>
