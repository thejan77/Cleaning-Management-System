<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="CmsConnectionString" connectionString="Data Source=192.168.80.151;Initial Catalog=CleaningManagement;Persist Security Info=True;User ID=cltintern;Password=Test@123" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <!--
      This overrides the site-wide Forms Authentication rule for everything inside /CMS/.
      Without this, ASP.NET intercepts unauthenticated requests here and force-redirects
      to LotusPro's root Login.aspx (via <authentication><forms loginUrl="..."> in the
      root web.config) before CmsMaster.master.cs ever gets a chance to run its own
      Session-based check and redirect to CmsLogin.aspx instead.
    -->
    <authorization>
      <allow users="*"/>
    </authorization>
    <compilation debug="true" targetFramework="4.8"/>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
</configuration>
